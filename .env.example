# ============================================================
# 小拍 · 拍照购物参谋 —— 环境配置示例
# 复制为 .env 后按需填写；【全部留空 = 离线 mock 模式，零 Key 可跑】
# ============================================================

# ---- 对话 LLM（OpenAI 兼容；默认 DeepSeek）----
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 显式指定模式（不填则按 Key 自动判定）：mock / real
# LLM_MODE=real

# ---- 视觉 VLM（OpenAI 兼容多模态；默认通义 qwen-vl）----
# VLM_API_KEY=sk-xxxxxxxx
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=qwen-vl-plus
# VLM_MODE=real

# ---- 比价工具 ----
# mock=演示数据（默认）；web=Tavily(可选)+DuckDuckGo+Bing 网页检索
# PRICE_MODE=web
# TAVILY_API_KEY=tvly-xxxxxxxx

# ---- 运行行为 ----
# 购买建议输出前人工确认（HITL，仅 CLI 交互终端生效）
# SNAP_CONFIRM=1
# 关闭证据约束（消融实验，正式使用请勿开启）
# SNAP_LOOSE=0
# 单轮问答最大工具调用轮数
# MAX_TOOL_ROUNDS=3
# web 检索超时（秒）
# REQUEST_TIMEOUT=8
