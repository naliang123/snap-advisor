# ============================================================
# 小拍 · 拍照购物参谋 —— 环境配置示例
# 复制为 .env 后按需填写；【全部留空 = 离线 mock 模式，零 Key 可跑】
# ============================================================

# ---- 对话 LLM（OpenAI 兼容；默认 DeepSeek）----
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 显式指定模式（不填则按 Key 自动判定）：mock / real
# LLM_MODE=real

# ---- 视觉 VLM（OpenAI 兼容多模态；默认通义 qwen-vl）----
# VLM_API_KEY=sk-xxxxxxxx
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=qwen-vl-plus
# VLM_MODE=real

# ---- 比价工具 ----
# mock=演示数据（默认）；web=Tavily(可选)+DuckDuckGo+Bing 网页检索
# PRICE_MODE=web
# TAVILY_API_KEY=tvly-xxxxxxxx

# ---- 检索（RAG：回忆用户说过什么 / 本地知识库）----
# 嵌入服务：留空则用【离线词面伪向量】（只比字面重合，不是语义检索）；
# 想要真正的语义召回，填一个 embedding 服务的 Key（可与对话模型不同供应商）
# EMBED_API_KEY=sk-xxxxxxxx
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small
# 检索策略：vector（纯向量）/ bm25（纯关键词）/ hybrid（混合，默认）
# RAG_MODE=hybrid
# 是否对候选重排（真实模式会多一次模型调用；实测 MRR 0.903→0.979）
# RAG_RERANK=1
# 问答结束后自动增量索引本轮对话（1=开）
# RAG_AUTO_INDEX=1

# ---- 运行行为 ----
# 购买建议输出前人工确认（HITL，仅 CLI 交互终端生效）
# SNAP_CONFIRM=1
# 关闭证据约束（消融实验，正式使用请勿开启）
# SNAP_LOOSE=0
# 单轮问答最大工具调用轮数
# MAX_TOOL_ROUNDS=3
# web 检索超时（秒）
# REQUEST_TIMEOUT=8
